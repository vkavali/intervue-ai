generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums (SQLite doesn't support native enums, so we use string fields) ───

// Role:              COMPANY_ADMIN | INTERVIEWER | CANDIDATE | SCHOOL_ADMIN
// Plan:              STARTER | GROWTH | ENTERPRISE | PAY_PER_INTERVIEW
// Seniority:         JUNIOR | MID | SENIOR | STAFF | PRINCIPAL
// Difficulty:        EASY | MEDIUM | HARD
// SessionStatus:     PENDING | ACTIVE | COMPLETED | CANCELLED
// SuggestedDecision: HIRE | NO_HIRE | FURTHER_ROUND

// ─── User ───────────────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  password           String
  role               String   // COMPANY_ADMIN | INTERVIEWER | CANDIDATE | SCHOOL_ADMIN
  companyId          String?
  activeSessionToken String?  // Current active session token for single-device enforcement
  lastLoginAt        DateTime? // Track last login time
  lastLoginIp        String?  // Track last login IP
  profilePublic      Boolean  @default(true)
  xp                 Int      @default(0)
  level              Int      @default(1)
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  lastActiveDate     DateTime?
  schoolId           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company             Company?           @relation(fields: [companyId], references: [id])
  school              School?            @relation(fields: [schoolId], references: [id])
  candidateSessions   InterviewSession[] @relation("CandidateSessions")
  interviewerSessions InterviewSession[] @relation("InterviewerSessions")
  aiLevelOverrides    AILevelOverride[]  @relation("OverriddenByUser")
  interviewerNotes    InterviewerNote[]  @relation("InterviewerNotes")
  candidatePipelines  CandidatePipeline[] @relation("CandidatePipelines")
  notifications       Notification[]     @relation("UserNotifications")
  practiceProblems    PracticeProblem[]  @relation("UserPracticeProblems")
  practiceProgress    PracticeProgress[] @relation("UserPracticeProgress")
  practiceSubmissions PracticeSubmission[] @relation("UserPracticeSubmissions")
  communitySubmissions CommunitySubmission[] @relation("UserCommunitySubmissions")
  weaknessProfile     WeaknessProfile?   @relation("UserWeaknessProfile")
  violations          Violation[]        @relation("UserViolations")
  chatMessages        ChatMessage[]      @relation("UserChatMessages")
  sessionLogs         SessionLog[]       @relation("UserSessionLogs")
  availability        InterviewerAvailability[] @relation("InterviewerAvailability")
  xpTransactions      XPTransaction[]    @relation("UserXPTransactions")
  badges              UserBadge[]        @relation("UserBadges")
  dailyActivities     DailyActivity[]    @relation("UserDailyActivities")
  adminSchool         School?            @relation("SchoolAdmin")
}

// ─── Company ────────────────────────────────────────────────────────────────────

model Company {
  id                      String    @id @default(cuid())
  name                    String
  slug                    String?   @unique
  logo                    String?
  plan                    String    // STARTER | GROWTH | ENTERPRISE | PAY_PER_INTERVIEW
  stripeCustomerId        String?
  razorpayCustomerId      String?
  razorpaySubscriptionId  String?
  paymentGateway          String?   // "stripe" | "razorpay"
  region                  String    @default("US") // "IN" | "US"
  currency                String    @default("usd") // "inr" | "usd"
  isLaunchOffer           Boolean   @default(false)
  trialEndsAt             DateTime?
  createdAt               DateTime  @default(now())

  users              User[]
  interviewTemplates InterviewTemplate[]
  interviewSessions  InterviewSession[]
  candidatePipelines CandidatePipeline[]
  hiringComparisons  HiringComparison[]
  openPositions      OpenPosition[]
}

// ─── InterviewTemplate ──────────────────────────────────────────────────────────

model InterviewTemplate {
  id                   String   @id @default(cuid())
  companyId            String
  title                String
  role                 String
  seniority            String   // JUNIOR | MID | SENIOR | STAFF | PRINCIPAL
  roundType            String
  defaultAiLevel       Int      @default(0) // 0-4
  industry             String?
  interviewType        String   @default("TECHNICAL") // TECHNICAL | SYSTEM_DESIGN | SQL | BEHAVIORAL | BUSINESS_ANALYST | PROJECT_MANAGEMENT | DEVOPS | GENERAL
  totalDurationMinutes Int?
  createdAt            DateTime @default(now())

  company           Company            @relation(fields: [companyId], references: [id])
  questions         Question[]
  interviewSessions InterviewSession[]
}

// ─── Question ───────────────────────────────────────────────────────────────────

model Question {
  id          String @id @default(cuid())
  templateId  String
  title       String
  description String
  constraints String?
  examples    String?
  difficulty  String  // EASY | MEDIUM | HARD
  aiLevel     Int     @default(0) // 0-4
  timeLimit   Int     // minutes
  orderIndex  Int
  testCases   String? // JSON: [{ input: "fnName(args)", expected: "result" }]
  starterCode String? // JSON: { javascript: "...", python: "...", ... }

  template InterviewTemplate @relation(fields: [templateId], references: [id])
}

// ─── InterviewSession ───────────────────────────────────────────────────────────

model InterviewSession {
  id                   String    @id @default(cuid())
  templateId           String
  companyId            String
  candidateId          String
  interviewerId        String?
  status               String    @default("PENDING") // PENDING | ACTIVE | COMPLETED | CANCELLED
  scheduledAt          DateTime?
  startedAt            DateTime?
  endedAt              DateTime?
  currentQuestionIndex Int       @default(0)
  code                 String?
  language             String?
  aiLevel              Int       @default(0) // 0-4
  totalDurationMinutes Int?
  createdAt            DateTime  @default(now())

  template         InterviewTemplate @relation(fields: [templateId], references: [id])
  company          Company           @relation(fields: [companyId], references: [id])
  candidate        User              @relation("CandidateSessions", fields: [candidateId], references: [id])
  interviewer      User?             @relation("InterviewerSessions", fields: [interviewerId], references: [id])
  aiInteractions   AIInteraction[]
  aiLevelOverrides AILevelOverride[]
  auditReport      AuditReport?
  thinkingAnalysis ThinkingAnalysis?
  interviewerNotes InterviewerNote[]
  violations       Violation[]
  chatMessages     ChatMessage[]
  sessionLogs      SessionLog[]
}

// ─── AIInteraction ──────────────────────────────────────────────────────────────

model AIInteraction {
  id        String   @id @default(cuid())
  sessionId String
  prompt    String
  response  String
  aiLevel   Int      // 0-4
  timestamp DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id])
}

// ─── AILevelOverride ────────────────────────────────────────────────────────────

model AILevelOverride {
  id            String   @id @default(cuid())
  sessionId     String
  previousLevel Int
  newLevel      Int
  reason        String
  overriddenById String
  timestamp     DateTime @default(now())

  session      InterviewSession @relation(fields: [sessionId], references: [id])
  overriddenBy User             @relation("OverriddenByUser", fields: [overriddenById], references: [id])
}

// ─── AuditReport ────────────────────────────────────────────────────────────────

model AuditReport {
  id                    String   @id @default(cuid())
  sessionId             String   @unique
  overallScore          Float
  problemComprehension  Float
  solutionCorrectness   Float
  codeQuality           Float
  communication         Float
  aiUsageQuality        Float
  timeManagement        Float
  thinkingTrace         String
  riskFlags             String   // JSON text
  quoteHighlights       String   // JSON text
  suggestedDecision     String   // HIRE | NO_HIRE | FURTHER_ROUND
  confidence            Float
  reasoning             String
  shareToken            String?  @unique
  createdAt             DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id])
}

// ─── InterviewerNote ────────────────────────────────────────────────────────────

model InterviewerNote {
  id            String   @id @default(cuid())
  sessionId     String
  interviewerId String
  content       String
  timestamp     DateTime @default(now())

  session     InterviewSession @relation(fields: [sessionId], references: [id])
  interviewer User             @relation("InterviewerNotes", fields: [interviewerId], references: [id])
}

// ─── CandidatePipeline ────────────────────────────────────────────────────────
// Tracks a candidate's journey through multiple interview rounds for a specific role

model CandidatePipeline {
  id          String   @id @default(cuid())
  companyId   String
  candidateId String
  role        String   // The job role they're being considered for
  seniority   String   // Target seniority level
  stage       String   @default("SCREENING") // SCREENING | TECHNICAL | SYSTEM_DESIGN | BEHAVIORAL | FINAL | HIRED | REJECTED | ON_HOLD
  notes       String?  // Internal recruiter/admin notes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  candidate User    @relation("CandidatePipelines", fields: [candidateId], references: [id])

  @@unique([companyId, candidateId, role])
}

// ─── HiringComparison ─────────────────────────────────────────────────────────
// AI-generated comparison report for candidates competing for the same role

model HiringComparison {
  id          String   @id @default(cuid())
  companyId   String
  role        String
  seniority   String
  analysis    String   // JSON text - the full AI comparison
  recommendation String // The recommended candidate and reasoning
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
}

// ─── Notification ──────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // CANDIDATE_CLEARED | SESSION_COMPLETED | REVIEW_PENDING | CANDIDATE_WAITING | PIPELINE_UPDATE | SYSTEM
  title     String
  message   String
  link      String?  // URL to navigate to when clicked
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id])
}

// ─── PracticeProblem ─────────────────────────────────────────────────────────
// AI-generated practice problems persisted for users

model PracticeProblem {
  id          String   @id @default(cuid())
  userId      String
  title       String
  difficulty  String   // EASY | MEDIUM | HARD
  description String
  constraints String?
  examples    String?
  tags        String   // JSON array as text
  starterCode String?  // JSON object as text { javascript: "...", python: "..." }
  testCases   String?  // JSON: [{ input: "fnName(args)", expected: "result" }]
  company     String?  // Company context if generated for specific company
  role        String?  // Role context if generated for specific role
  createdAt   DateTime @default(now())

  user            User               @relation("UserPracticeProblems", fields: [userId], references: [id])
  progress        PracticeProgress[] @relation("ProblemProgress")
  dailyChallenges DailyChallenge[]   @relation("ChallengeProblem")
}

// ─── PracticeProgress ────────────────────────────────────────────────────────
// Tracks user progress on practice problems (both bank and AI-generated)

model PracticeProgress {
  id               String    @id @default(cuid())
  userId           String
  problemId        String?   // FK to PracticeProblem (for AI-generated)
  bankProblemId    String?   // ID from problem bank (for static problems)
  code             String?   // Last saved code
  language         String?   // Last used language
  status           String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | ABANDONED
  timeSpentSeconds Int       @default(0)
  notes            String?   // Personal markdown notes
  bestSubmissionId String?   // ID of best submission
  lastSavedAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User                @relation("UserPracticeProgress", fields: [userId], references: [id])
  problem     PracticeProblem?    @relation("ProblemProgress", fields: [problemId], references: [id])
  submissions PracticeSubmission[] @relation("ProgressSubmissions")

  @@unique([userId, problemId])
  @@unique([userId, bankProblemId])
}

// ─── PracticeSubmission ──────────────────────────────────────────────────────
// Immutable record per submit attempt

model PracticeSubmission {
  id               String   @id @default(cuid())
  userId           String
  progressId       String
  bankProblemId    String?
  problemId        String?
  code             String
  language         String
  status           String   // ACCEPTED | WRONG_ANSWER | PARTIAL
  testsPassed      Int      @default(0)
  testsTotal       Int      @default(0)
  timeSpentSeconds Int      @default(0)
  submittedAt      DateTime @default(now())

  user     User             @relation("UserPracticeSubmissions", fields: [userId], references: [id])
  progress PracticeProgress @relation("ProgressSubmissions", fields: [progressId], references: [id], onDelete: Cascade)
}

// ─── CommunitySubmission ─────────────────────────────────────────────────────
// Accepted solutions contributed to the community bank

model CommunitySubmission {
  id            String   @id @default(cuid())
  bankProblemId String
  userId        String
  code          String
  language      String
  submittedAt   DateTime @default(now())

  user User @relation("UserCommunitySubmissions", fields: [userId], references: [id])

  @@unique([bankProblemId, userId, language])
}

// ─── Violation ──────────────────────────────────────────────────────────────
// Persisted anti-cheat violation events

model Violation {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  type      String   // TAB_SWITCH, COPY_ATTEMPT, PASTE_ATTEMPT, WINDOW_BLUR, etc.
  details   String?
  timestamp DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id])
  user    User             @relation("UserViolations", fields: [userId], references: [id])
}

// ─── ChatMessage ────────────────────────────────────────────────────────────
// In-session chat between interviewer and candidate

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  senderId  String
  content   String
  timestamp DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id])
  sender  User             @relation("UserChatMessages", fields: [senderId], references: [id])
}

// ─── SessionLog ─────────────────────────────────────────────────────────────
// Activity logs for session events

model SessionLog {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  action    String   // JOIN, LEAVE, CODE_CHANGE, LANGUAGE_CHANGE, AI_REQUEST, NOTE_ADDED, OVERRIDE, VIOLATION
  details   String?
  timestamp DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id])
  user    User             @relation("UserSessionLogs", fields: [userId], references: [id])
}

// ─── InterviewerAvailability ────────────────────────────────────────────────
// Scheduling availability for interviewers

model InterviewerAvailability {
  id            String   @id @default(cuid())
  interviewerId String
  date          DateTime
  startTime     String   // HH:mm format
  endTime       String   // HH:mm format
  createdAt     DateTime @default(now())

  interviewer User @relation("InterviewerAvailability", fields: [interviewerId], references: [id])
}

// ─── EnrichedBankProblem ────────────────────────────────────────────────────
// Cached AI-enriched data for bank problems (constraints, starter code, test cases)

model EnrichedBankProblem {
  id            String   @id @default(cuid())
  bankProblemId String   @unique
  constraints   String?
  examples      String?
  starterCode   String?  // JSON: { javascript: "...", python: "...", java: "..." }
  testCases     String?  // JSON: [{ input: "...", expected: "..." }]
  createdAt     DateTime @default(now())
}

// ─── OpenPosition ─────────────────────────────────────────────────────────
// Tracks active hiring needs / job requisitions

model OpenPosition {
  id              String   @id @default(cuid())
  companyId       String
  title           String
  role            String
  seniority       String   // JUNIOR | MID | SENIOR | STAFF | PRINCIPAL
  department      String?
  location        String?
  description     String?
  interviewType   String?  // Links to INTERVIEW_TYPES config
  isPublic        Boolean  @default(true)
  requirements    String?  // Markdown or plain text
  benefits        String?  // Markdown or plain text
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?  @default("USD")
  headcount       Int      @default(1)
  status          String   @default("OPEN") // OPEN | PAUSED | CLOSED | FILLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company      Company          @relation(fields: [companyId], references: [id])
  applications JobApplication[]
}

// ─── JobApplication ──────────────────────────────────────────────────────
// Public job applications from the job board

model JobApplication {
  id          String   @id @default(cuid())
  positionId  String
  name        String
  email       String
  phone       String?
  resumeUrl   String?
  coverLetter String?
  linkedinUrl String?
  status      String   @default("NEW") // NEW | REVIEWING | SHORTLISTED | REJECTED | HIRED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  position OpenPosition @relation(fields: [positionId], references: [id])

  @@unique([positionId, email])
}

// ─── ProblemHints ──────────────────────────────────────────────────────────
// Cached structured hints for bank problems (3-level progressive)

model ProblemHints {
  id            String   @id @default(cuid())
  bankProblemId String   @unique
  hints         String   // JSON: { pattern, dataStructure, approach }
  createdAt     DateTime @default(now())
}

// ─── ProblemEditorial ─────────────────────────────────────────────────────
// AI-generated editorial with multiple solution approaches

model ProblemEditorial {
  id              String   @id @default(cuid())
  bankProblemId   String   @unique
  intuition       String
  bruteForce      String
  optimized       String
  complexity      String
  codeWalkthrough String
  createdAt       DateTime @default(now())
}

// ─── ProblemQualityScore ──────────────────────────────────────────────────
// AI-evaluated quality metrics for bank problems

model ProblemQualityScore {
  id                 String   @id @default(cuid())
  bankProblemId      String   @unique
  overallScore       Int
  clarity            Int
  usefulness         Int
  ambiguity          Int
  exampleQuality     Int
  difficultyAccuracy Int
  createdAt          DateTime @default(now())
}

// ─── WeaknessProfile ──────────────────────────────────────────────────────
// User weakness analysis based on practice history

model WeaknessProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  profile   String   // JSON: WeaknessProfileData
  updatedAt DateTime @updatedAt
  user      User     @relation("UserWeaknessProfile", fields: [userId], references: [id])
}

// ─── ThinkingAnalysis ─────────────────────────────────────────────────────
// Persisted AI thinking analysis for interview sessions

model ThinkingAnalysis {
  id                  String   @id @default(cuid())
  sessionId           String   @unique
  overallApproach     String
  thinkingPatterns    String   // JSON: ThinkingPattern[]
  problemSolvingStage String
  strengths           String   // JSON: string[]
  concerns            String   // JSON: string[]
  aiUsagePattern      String
  suggestedFollowUp   String   // JSON: string[]
  confidenceLevel     String   // high | medium | low
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  session InterviewSession @relation(fields: [sessionId], references: [id])
}

// ─── Gamification ─────────────────────────────────────────────────────────

model XPTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String   // PROBLEM_SOLVED, DAILY_LOGIN, STREAK_BONUS, BADGE_EARNED, DAILY_CHALLENGE
  sourceId  String?  // optional link to problem/session
  createdAt DateTime @default(now())

  user User @relation("UserXPTransactions", fields: [userId], references: [id])
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  icon        String      // emoji or icon key
  category    String      // SKILL, STREAK, MILESTONE, SPECIAL
  threshold   Int         // e.g. 7 for "7-day streak"
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user  User  @relation("UserBadges", fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model DailyActivity {
  id        String   @id @default(cuid())
  userId    String
  date      String   // "YYYY-MM-DD" for heatmap
  problems  Int      @default(0)
  xpEarned  Int      @default(0)

  user User @relation("UserDailyActivities", fields: [userId], references: [id])

  @@unique([userId, date])
}

model DailyChallenge {
  id        String   @id @default(cuid())
  date      String   @unique  // "YYYY-MM-DD"
  problemId String
  bonusXP   Int      @default(50)

  problem PracticeProblem @relation("ChallengeProblem", fields: [problemId], references: [id])
}

// ─── School Partnership ───────────────────────────────────────────────────

model School {
  id                      String   @id @default(cuid())
  name                    String
  enrollmentCode          String   @unique
  maxStudents             Int      @default(100)
  plan                    String   @default("EDUCATION")
  adminId                 String   @unique
  razorpaySubscriptionId  String?
  paymentGateway          String?  // "stripe" | "razorpay"
  region                  String   @default("US") // "IN" | "US"
  currency                String   @default("usd") // "inr" | "usd"
  createdAt               DateTime @default(now())

  admin    User   @relation("SchoolAdmin", fields: [adminId], references: [id])
  students User[]
}

model SchoolAssignment {
  id          String   @id @default(cuid())
  schoolId    String
  title       String
  description String?
  problemIds  String   // JSON array of problem IDs
  dueDate     DateTime?
  createdAt   DateTime @default(now())
}

// ─── Launch Offer Counter ─────────────────────────────────────────────────────

model LaunchOfferCounter {
  id        String   @id @default("india-launch-2026")
  count     Int      @default(0)
  maxCount  Int      @default(100)
  updatedAt DateTime @updatedAt
}
